@page "/authors/{Id:int}/edit"
@inject AuthorApiClient AuthorApi
@inject NavigationManager Nav

<PageTitle>Edit author</PageTitle>

@if (notFound)
{
    <p>Author not found.</p>
}
else if (request is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1 class="h3 mb-3">Edit author</h1>

    <EditForm Model="@request" OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="request.Name" />
                <ValidationMessage For="@(() => request.Name)" class="text-danger" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Nationality</label>
                <InputText class="form-control" @bind-Value="request.Nationality" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Birth date</label>
                <InputDate class="form-control" @bind-Value="request.BirthDate" />
            </div>
            <div class="col-12">
                <label class="form-label">Bio</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="request.Bio" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="authors">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    private AuthorRequest? request;
    private bool notFound;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        var existing = await AuthorApi.GetByIdAsync(Id);
        if (existing is null)
        {
            notFound = true;
            return;
        }

        request = new AuthorRequest
        {
            Name = existing.Name,
            Bio = existing.Bio,
            BirthDate = existing.BirthDate,
            Nationality = existing.Nationality
        };
    }

    private async Task HandleUpdate()
    {
        error = null;
        try
        {
            var updated = await AuthorApi.UpdateAsync(Id, request!);
            if (updated is null)
            {
                notFound = true;
                return;
            }

            Nav.NavigateTo("authors");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }
}
