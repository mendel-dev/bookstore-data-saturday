@page "/books/{Id:int}/delete"
@inject BookApiClient BookApi
@inject NavigationManager Nav

<PageTitle>Delete book</PageTitle>

@if (notFound)
{
    <p>Book not found.</p>
}
else if (book is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1 class="h3 mb-3 text-danger">Delete book</h1>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    <p>Are you sure you want to delete this book?</p>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@book.Title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@book.AuthorName</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@book.Price.ToString("C")</dd>
    </dl>

    <button class="btn btn-danger" @onclick="HandleDelete">Delete</button>
    <a class="btn btn-secondary" href="books">Cancel</a>
}

@code {
    [Parameter] public int Id { get; set; }
    private BookResponse? book;
    private bool notFound;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        book = await BookApi.GetByIdAsync(Id);
        notFound = book is null;
    }

    private async Task HandleDelete()
    {
        error = null;
        try
        {
            await BookApi.DeleteAsync(Id);
            Nav.NavigateTo("books");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }
}
