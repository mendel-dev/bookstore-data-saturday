@page "/books"
@inject BookApiClient BookApi

<PageTitle>Books</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Books</h1>
    <a class="btn btn-primary" href="books/new">New book</a>
</div>

@if (books is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th>Available</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.AuthorName</td>
                        <td>@book.Genre</td>
                        <td class="text-end">@book.Price.ToString("C")</td>
                        <td class="text-end">@book.Stock</td>
                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"books/{book.Id}")">Details</a>
                            <a class="btn btn-sm btn-outline-primary" href="@($"books/{book.Id}/edit")">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" href="@($"books/{book.Id}/delete")">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<BookResponse>? books;

    protected override async Task OnInitializedAsync()
    {
        books = await BookApi.GetAllAsync();
    }
}
