@page "/books/{Id:int}"
@inject BookApiClient BookApi

<PageTitle>Book details</PageTitle>

@if (notFound)
{
    <p>Book not found.</p>
}
else if (book is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1 class="h3 mb-3">@book.Title</h1>

    <dl class="row">
        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@book.AuthorName</dd>

        <dt class="col-sm-3">Genre</dt>
        <dd class="col-sm-9">@book.Genre</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@book.Isbn</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@book.Price.ToString("C")</dd>

        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@book.Stock</dd>

        <dt class="col-sm-3">Available</dt>
        <dd class="col-sm-9">@(book.IsAvailable ? "Yes" : "No")</dd>

        <dt class="col-sm-3">Published</dt>
        <dd class="col-sm-9">@book.PublishedDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@book.Description</dd>
    </dl>

    <a class="btn btn-secondary" href="books">Back</a>
    <a class="btn btn-primary" href="@($"books/{book.Id}/edit")">Edit</a>
}

@code {
    [Parameter] public int Id { get; set; }
    private BookResponse? book;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        book = await BookApi.GetByIdAsync(Id);
        notFound = book is null;
    }
}
